{
  "schemaVersion": 1,
  "enabled": true,
  "id": "codevember.fold",
  "slug": "fold",
  "name": "Fold",
  "version": "1.0.0",
  "description": "Folding paper chains that recede into a lit vanishing point.",
  "author": "Yuri Artiukh",
  "license": "CC-BY-4.0",
  "source": {
    "html": "index.html",
    "module": "src/index.ts"
  },
  "entry": "lull/entry.ts",
  "theme": {
    "background": "#333333"
  },
  "capabilities": [
    "wallpaper.viewport",
    "wallpaper.params",
    "wallpaper.script"
  ],
  "performance": {
    "tier": "high",
    "targetFps": 60
  },
  "compatibility": {
    "hostApi": 1,
    "platforms": [
      "windows"
    ]
  },
  "requires": [
    "webgpu"
  ],
  "assets": [],
  "hide": [
    ".lil-gui",
    "#stats",
    ".pages",
    ".balls",
    ".hud"
  ],
  "assetsLicense": "ok",
  "params": [
    {
      "key": "chains",
      "type": "number",
      "label": "链数 / Chains",
      "default": 16,
      "min": 1,
      "max": 16,
      "step": 1,
      "binding": {
        "property": "chains"
      },
      "apply": "finish"
    },
    {
      "key": "spread",
      "type": "number",
      "label": "链头错开 / Spread",
      "default": 1.5,
      "min": 0,
      "max": 5,
      "step": 0.05,
      "binding": {
        "property": "spread"
      },
      "apply": "finish"
    },
    {
      "key": "seed",
      "type": "number",
      "label": "随机种子 / Seed",
      "default": 1,
      "min": 1,
      "max": 100,
      "step": 1,
      "binding": {
        "property": "seed"
      },
      "apply": "finish"
    },
    {
      "key": "camera-dolly",
      "type": "number",
      "label": "相机推拉 / Dolly",
      "description": "相机距离倍数：小于 1.5 向前推近，大于 1.5 向后拉远；1.5 为默认机位。",
      "default": 1.5,
      "min": 1,
      "max": 2.5,
      "step": 0.05,
      "binding": {
        "property": "camDistance"
      },
      "apply": "change"
    },
    {
      "key": "camera-yaw",
      "type": "number",
      "label": "相机水平旋转 / Yaw",
      "default": 0,
      "min": -180,
      "max": 180,
      "step": 1,
      "binding": {
        "property": "cameraYaw"
      },
      "apply": "change"
    },
    {
      "key": "camera-pitch",
      "type": "number",
      "label": "相机俯仰 / Pitch",
      "default": 0,
      "min": -60,
      "max": 60,
      "step": 1,
      "binding": {
        "property": "cameraPitch"
      },
      "apply": "change"
    },
    {
      "key": "camera-roll",
      "type": "number",
      "label": "相机翻滚 / Roll",
      "default": 0,
      "min": -180,
      "max": 180,
      "step": 1,
      "binding": {
        "property": "cameraRoll"
      },
      "apply": "change"
    },
    {
      "key": "theme",
      "type": "enum",
      "label": "主题样式 / Theme",
      "default": "night",
      "binding": {
        "property": "theme"
      },
      "options": [
        {
          "value": "night",
          "label": "夜间 / Night"
        },
        {
          "value": "day",
          "label": "日间 / Day"
        }
      ],
      "apply": "change"
    },
    {
      "key": "curve-color",
      "type": "color",
      "label": "曲线颜色 / Curve colour",
      "default": "#0b0b0d",
      "binding": {
        "property": "curveColor"
      }
    }
  ]
}
