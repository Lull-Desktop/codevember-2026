{
  "schemaVersion": 1,
  "enabled": true,
  "id": "codevember.spore",
  "slug": "spore",
  "name": "Spore",
  "version": "1.0.0",
  "description": "Glowing mushrooms release spores into a dark, damp room.",
  "author": "Yuri Artiukh",
  "license": "CC-BY-4.0",
  "source": {
    "html": "index.html",
    "module": "src/index.ts"
  },
  "entry": "lull/entry.ts",
  "theme": {
    "background": "#05080e"
  },
  "capabilities": [
    "wallpaper.viewport",
    "wallpaper.params",
    "wallpaper.script"
  ],
  "performance": {
    "tier": "high",
    "targetFps": 60
  },
  "compatibility": {
    "hostApi": 1,
    "platforms": [
      "windows"
    ]
  },
  "requires": [
    "webgpu"
  ],
  "assets": [
    "public/spore.bin"
  ],
  "hide": [
    ".lil-gui",
    "#stats",
    ".pages",
    ".balls",
    ".hud"
  ],
  "assetsLicense": "review",
  "params": [
    {
      "key": "density",
      "type": "number",
      "label": "蘑菇密度 / Density",
      "default": 1,
      "min": 0.15,
      "max": 1,
      "step": 0.01,
      "binding": {
        "property": "density"
      }
    },
    {
      "key": "lamp",
      "type": "number",
      "label": "菌灯 / Lamp",
      "default": 4.25,
      "min": 0,
      "max": 8,
      "step": 0.05,
      "binding": {
        "property": "lamp"
      }
    },
    {
      "key": "redden",
      "type": "number",
      "label": "暖红 / Redden",
      "default": 1.5,
      "min": 0,
      "max": 3,
      "step": 0.01,
      "binding": {
        "property": "redden"
      }
    },
    {
      "key": "pour",
      "type": "number",
      "label": "孢子流 / Spore pour",
      "default": 1,
      "min": 0,
      "max": 4,
      "step": 0.01,
      "binding": {
        "property": "pour"
      }
    },
    {
      "key": "flop",
      "type": "number",
      "label": "菌盖下垂 / Cap flop",
      "default": 0.03,
      "min": 0,
      "max": 0.08,
      "step": 0.001,
      "binding": {
        "property": "flop"
      }
    }
  ]
}
