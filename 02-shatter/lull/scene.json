{
  "schemaVersion": 1,
  "enabled": true,
  "id": "codevember.shatter",
  "slug": "shatter",
  "name": "Shatter",
  "version": "1.0.0",
  "description": "A glass sphere shatters in a loop, with the shards caught in the light.",
  "author": "Yuri Artiukh",
  "license": "CC-BY-4.0",
  "source": {
    "html": "index.html",
    "module": "src/index.ts"
  },
  "entry": "lull/entry.ts",
  "theme": {
    "background": "#000000"
  },
  "capabilities": [
    "wallpaper.viewport",
    "wallpaper.params",
    "wallpaper.script"
  ],
  "performance": {
    "tier": "medium",
    "targetFps": 60
  },
  "compatibility": {
    "hostApi": 1,
    "platforms": [
      "windows"
    ]
  },
  "requires": [
    "webgpu"
  ],
  "assets": [
    "public/bake/thin.bin",
    "public/bake/medium.bin",
    "public/bake/thick.bin"
  ],
  "hide": [
    ".lil-gui",
    "#stats",
    ".pages",
    ".balls",
    ".hud"
  ],
  "assetsLicense": "review",
  "params": [
    {
      "key": "speed",
      "type": "number",
      "label": "速度 / Speed",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.01,
      "binding": {
        "property": "speed"
      }
    },
    {
      "key": "phase",
      "type": "number",
      "label": "相位 / Phase",
      "default": 0,
      "min": 0,
      "max": 0.9999,
      "step": 0.0001,
      "binding": {
        "property": "phase"
      }
    }
  ]
}
