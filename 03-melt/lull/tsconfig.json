{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@lull/scene-sdk": [
        "../../tools/lull/scene-sdk/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "../../tools/lull/runtime/**/*.ts"
  ]
}
