{
  "schemaVersion": 1,
  "enabled": true,
  "id": "codevember.feather",
  "slug": "feather",
  "name": "Feather",
  "version": "1.0.0",
  "description": "A feather becomes a bird and joins a V of herons over water.",
  "author": "Yuri Artiukh",
  "license": "CC-BY-4.0",
  "source": {
    "html": "index.html",
    "module": "src/index.ts"
  },
  "entry": "lull/entry.ts",
  "theme": {
    "background": "#4f86bd"
  },
  "capabilities": [
    "wallpaper.viewport",
    "wallpaper.params",
    "wallpaper.script"
  ],
  "performance": {
    "tier": "high",
    "targetFps": 60
  },
  "compatibility": {
    "hostApi": 1,
    "platforms": [
      "windows"
    ]
  },
  "requires": [
    "webgpu"
  ],
  "assets": [
    "public/sky.png",
    "public/sun.png"
  ],
  "hide": [
    ".lil-gui",
    "#stats",
    ".pages",
    ".balls",
    ".hud"
  ],
  "assetsLicense": "review",
  "params": [
    {
      "key": "beats",
      "type": "number",
      "label": "振翅次数 / Beats",
      "default": 10,
      "min": 4,
      "max": 24,
      "step": 1,
      "binding": {
        "property": "beats"
      }
    },
    {
      "key": "glide",
      "type": "number",
      "label": "滑翔占比 / Glide",
      "default": 0.22,
      "min": 0,
      "max": 0.9,
      "step": 0.01,
      "binding": {
        "property": "glide"
      }
    },
    {
      "key": "wave",
      "type": "number",
      "label": "波次 / Wave",
      "default": 0.16,
      "min": 0,
      "max": 0.5,
      "step": 0.01,
      "binding": {
        "property": "wave"
      }
    },
    {
      "key": "swing",
      "type": "number",
      "label": "羽毛摆幅 / Feather swing",
      "default": 0.5,
      "min": 0,
      "max": 1.2,
      "step": 0.01,
      "binding": {
        "property": "swing"
      }
    }
  ]
}
