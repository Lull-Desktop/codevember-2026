{
  "schemaVersion": 1,
  "enabled": true,
  "id": "codevember.labyrinth",
  "slug": "labyrinth",
  "name": "Labyrinth",
  "version": "1.0.0",
  "description": "A tiny clay labyrinth of stairs and walkers, lit at dusk.",
  "author": "Yuri Artiukh",
  "license": "CC-BY-4.0",
  "source": {
    "html": "index.html",
    "module": "src/stairs/index.ts"
  },
  "entry": "lull/entry.ts",
  "theme": {
    "background": "#c98f86"
  },
  "capabilities": [
    "wallpaper.viewport",
    "wallpaper.params",
    "wallpaper.script"
  ],
  "performance": {
    "tier": "medium",
    "targetFps": 60
  },
  "compatibility": {
    "hostApi": 1,
    "platforms": [
      "windows"
    ]
  },
  "requires": [
    "webgpu"
  ],
  "assets": [],
  "hide": [
    ".lil-gui",
    "#stats",
    ".pages",
    ".balls",
    ".hud"
  ],
  "assetsLicense": "ok",
  "params": [
    {
      "key": "pace",
      "type": "number",
      "label": "步速 / Pace",
      "default": 1.7,
      "min": 0.5,
      "max": 4,
      "step": 0.05,
      "binding": {
        "property": "pace"
      }
    },
    {
      "key": "walkers",
      "type": "number",
      "label": "行人 / Walkers",
      "default": 0.9,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "binding": {
        "property": "walkers"
      }
    },
    {
      "key": "exposure",
      "type": "number",
      "label": "曝光 / Exposure",
      "default": 1,
      "min": 0.1,
      "max": 3,
      "step": 0.01,
      "binding": {
        "property": "exposure"
      }
    },
    {
      "key": "seed",
      "type": "number",
      "label": "种子 / Seed",
      "default": 1,
      "min": 1,
      "max": 999,
      "step": 1,
      "binding": {
        "property": "seed"
      },
      "apply": "finish"
    }
  ]
}
