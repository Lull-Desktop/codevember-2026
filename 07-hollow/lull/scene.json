{
  "schemaVersion": 1,
  "enabled": true,
  "id": "codevember.hollow",
  "slug": "hollow",
  "name": "Hollow",
  "version": "1.0.0",
  "description": "A bone lattice tunnel folds and opens toward a warm light.",
  "author": "Yuri Artiukh",
  "license": "CC-BY-4.0",
  "source": {
    "html": "index.html",
    "module": "src/tunnel/index.ts"
  },
  "entry": "lull/entry.ts",
  "theme": {
    "background": "#e8e2d8"
  },
  "capabilities": [
    "wallpaper.viewport",
    "wallpaper.params",
    "wallpaper.script"
  ],
  "performance": {
    "tier": "high",
    "targetFps": 60
  },
  "compatibility": {
    "hostApi": 1,
    "platforms": [
      "windows"
    ]
  },
  "requires": [
    "webgpu"
  ],
  "assets": [],
  "hide": [
    ".lil-gui",
    "#stats",
    ".pages",
    ".balls",
    ".hud"
  ],
  "assetsLicense": "ok",
  "params": [
    {
      "key": "radius",
      "type": "number",
      "label": "半径 / Radius",
      "default": 1.3,
      "min": 0.6,
      "max": 2,
      "step": 0.01,
      "binding": {
        "property": "radius"
      }
    },
    {
      "key": "thickness",
      "type": "number",
      "label": "孔深 / Wells' depth",
      "default": 0.03,
      "min": 0.004,
      "max": 0.12,
      "step": 0.001,
      "binding": {
        "property": "thickness"
      }
    },
    {
      "key": "size",
      "type": "number",
      "label": "孔大小 / Cell size",
      "default": 0.05,
      "min": 0.03,
      "max": 0.3,
      "step": 0.001,
      "binding": {
        "property": "size"
      }
    },
    {
      "key": "sun",
      "type": "number",
      "label": "太阳 / Sun",
      "default": 2.3,
      "min": 0,
      "max": 10,
      "step": 0.01,
      "binding": {
        "property": "sun"
      }
    },
    {
      "key": "haze",
      "type": "number",
      "label": "雾 / Haze",
      "default": 0.085,
      "min": 0,
      "max": 0.8,
      "step": 0.005,
      "binding": {
        "property": "haze"
      }
    }
  ]
}
