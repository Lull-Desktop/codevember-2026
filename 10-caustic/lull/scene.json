{
  "schemaVersion": 1,
  "enabled": true,
  "id": "codevember.caustic",
  "slug": "caustic",
  "name": "Caustic",
  "version": "1.0.0",
  "description": "A caustic tunnel of sand and light, folding through a loop.",
  "author": "Yuri Artiukh",
  "license": "CC-BY-4.0",
  "source": {
    "html": "index.html",
    "module": "src/tunnel/index.ts"
  },
  "entry": "lull/entry.ts",
  "theme": {
    "background": "#2f6f86"
  },
  "capabilities": [
    "wallpaper.viewport",
    "wallpaper.params",
    "wallpaper.script"
  ],
  "performance": {
    "tier": "high",
    "targetFps": 60
  },
  "compatibility": {
    "hostApi": 1,
    "platforms": [
      "windows"
    ]
  },
  "requires": [
    "webgpu"
  ],
  "assets": [
    "public/rapan.glb"
  ],
  "hide": [
    ".lil-gui",
    "#stats",
    ".pages",
    ".balls",
    ".hud"
  ],
  "assetsLicense": "review",
  "params": [
    {
      "key": "ripples",
      "type": "number",
      "label": "波纹数 / Ripples",
      "default": 215,
      "min": 40,
      "max": 400,
      "step": 1,
      "binding": {
        "property": "ripples"
      }
    },
    {
      "key": "strength",
      "type": "number",
      "label": "焦散强度 / Caustic strength",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.01,
      "binding": {
        "property": "strength"
      }
    },
    {
      "key": "speed",
      "type": "number",
      "label": "波速 / Wave speed",
      "default": 1,
      "min": 0,
      "max": 4,
      "step": 0.01,
      "binding": {
        "property": "speed"
      }
    },
    {
      "key": "depth",
      "type": "number",
      "label": "光层高度 / Light sheet",
      "default": 0.55,
      "min": 0.1,
      "max": 0.9,
      "step": 0.005,
      "binding": {
        "property": "depth"
      }
    },
    {
      "key": "spread",
      "type": "number",
      "label": "色散 / Colour spread",
      "default": 0.06,
      "min": 0,
      "max": 0.12,
      "step": 0.001,
      "binding": {
        "property": "spread"
      }
    }
  ]
}
